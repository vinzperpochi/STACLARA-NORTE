# Keep real credentials in an untracked .env file.
FLASK_CONFIG=development
SECRET_KEY=
# Blank uses local SQLite in development. Production requires a configured database.
DATABASE_URL=
STORAGE_ROOT=instance
LOG_FILE=instance/logs/barangay_records.log
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=5242880
MAX_IMAGE_BYTES=5242880
SYSTEM_TIMEZONE=Asia/Manila
BARANGAY_NAME=Barangay Sta. Clara Norte
CHATBOT_NAME=Barangay Sta. Clara Norte Assistant
PASSWORD_MIN_LENGTH=12
REQUIRE_EMAIL_VERIFICATION_FOR_APPROVAL=1
APP_BASE_URL=http://127.0.0.1:5000
DOCUMENT_VERIFICATION_BASE_URL=http://127.0.0.1:5000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Barangay Sta. Clara Norte
SMTP_STARTTLS=1
SMTP_USE_SSL=0
SMTP_TIMEOUT=15
GEMINI_API_KEY=
NOMINATIM_USER_AGENT=BarangayManagementSystem
HOST=127.0.0.1
PORT=5000

# Total multipart request limit; each image remains limited to 5 MB.
MAX_REQUEST_BYTES=16777216

# Optional original-template PDF renderer override (Windows bundle is auto-detected).
DOCUMENT_PDF_RENDERER=
DOCUMENT_PDF_BROWSER=
# Enter actual office contacts; the sample phone in the supplied template is never printed.
BARANGAY_CONTACT_PHONE=
BARANGAY_CONTACT_EMAIL=

# Enable only on an isolated test database with synthetic personnel.
ATTENDANCE_DEV_MODE=false
# Local Wi-Fi demo only: no manual reader credential or TLS certificate.
# Pair the single ESP32 by opening Scan RFID Card/Tag once; use a LAN IP URL.
# Rejected in production. Keep this server off the public Internet.
ATTENDANCE_LOCAL_TEST_MODE=false
ATTENDANCE_OFFLINE_WINDOW_DAYS=7
# Administrative review windows, not automatic deletion or a legal retention mandate.
ATTENDANCE_RETENTION_DAYS=2555
INCIDENT_RETENTION_DAYS=2555
